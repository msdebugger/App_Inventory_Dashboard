# Copy this file to .env and adjust values for your environment.

# --- Core ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL Database ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=

# Set to True to use SQLite instead of PostgreSQL (quick local demo only)
USE_SQLITE=False

TIME_ZONE=UTC
